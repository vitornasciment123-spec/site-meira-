<script>
  // Signature scoreboard clock: counts up as a "time since last session" ticker
  let seconds = 3 * 3600 + 47 * 60 + 12; // starting placeholder duration
  const clockEl = document.getElementById('clock');
  function formatClock(totalSeconds){
    const h = Math.floor(totalSeconds / 3600);
    const m = Math.floor((totalSeconds % 3600) / 60);
    const s = totalSeconds % 60;
    const pad = n => String(n).padStart(2,'0');
    return h > 0 ? `${pad(h)}:${pad(m)}:${pad(s)}` : `${pad(m)}:${pad(s)}`;
  }
  function tick(){
    seconds++;
    clockEl.textContent = formatClock(seconds);
  }
  clockEl.textContent = formatClock(seconds);
  setInterval(tick, 1000);

  // Prevent actual form submission (no backend wired yet)
